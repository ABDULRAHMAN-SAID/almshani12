rules_version = '2';
// قواعد أمان مبادرة البصيرة — تُلصق في Firebase Console ← Firestore Database ← Rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isTeacher() { return signedIn() && exists(/databases/$(database)/documents/basira_admins/$(me())); }
    function myRole() { return get(/databases/$(database)/documents/basira_users/$(me())).data.role; }
    function linkOf(uid) { return /databases/$(database)/documents/basira_links/$(me() + '_' + get(/databases/$(database)/documents/basira_users/$(uid)).data.key); }
    function approvedParentOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/basira_users/$(uid))
        && exists(linkOf(uid)) && get(linkOf(uid)).data.status == 'approved';
    }

    // رمز تفعيل لوحة المعلمة: يُطلب مرة واحدة عند إنشاء حسابها
    match /basira_admins/{uid} {
      allow read: if signedIn() && me() == uid;
      // حساب المعلمة ثابت: لا يصير أحد معلمةً إلا بحسابها هي
      allow create: if signedIn() && me() == uid && request.resource.data.key == "506887"
        && request.auth.token.email == "udb55fbc642688abf3b087ce90c53b798@basira-school.app";
      allow update, delete: if false;
    }

    // الحسابات: الاسم الثلاثي ونوع الحساب والنقاط
    match /basira_users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'key', 'role', 'points', 'createdAt', 'cls'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && (!('cls' in request.resource.data) || (request.resource.data.cls is string && request.resource.data.cls.size() <= 8))
        && request.resource.data.points == 0
        && (request.resource.data.role in ['student', 'parent']
            || (request.resource.data.role == 'teacher'
                && getAfter(/databases/$(database)/documents/basira_admins/$(uid)).data.key == "506887"));
      allow update: if isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']);
      allow delete: if isTeacher();
    }

    // طلبات أولياء الأمور: المعرّف = uidولي الأمر_مفتاح الطالبة في قائمة الصف
    match /basira_links/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.parentUid == me());
      allow create: if signedIn() && myRole() == 'parent'
        && request.resource.data.skey is string && request.resource.data.skey.size() <= 40
        && id == me() + '_' + request.resource.data.skey
        && request.resource.data.parentUid == me()
        && request.resource.data.status == 'pending';
      allow update: if isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']);
      allow delete: if isTeacher() || (signedIn() && resource.data.parentUid == me());
    }

    // نتائج الاختبارات والألعاب
    match /basira_results/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == me()) || approvedParentOf(resource.data.uid);
      allow create: if signedIn() && request.resource.data.uid == me() && myRole() == 'student';
      allow update: if false;
      allow delete: if isTeacher();
    }

    // ملاحظات المعلمة وولي الأمر حول الطالبة
    match /basira_notes/{id} {
      allow read: if isTeacher() || approvedParentOf(resource.data.sid);
      allow create: if isTeacher()
        || (approvedParentOf(request.resource.data.sid) && request.resource.data.from == 'parent' && request.resource.data.uid == me());
      allow update: if false;
      allow delete: if isTeacher();
    }

    // تلخيصات الكتب
    match /basira_summaries/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == me());
      allow create: if signedIn() && request.resource.data.uid == me() && myRole() == 'student';
      allow update, delete: if isTeacher();
    }

    // النقاط: وثيقة لكل مكافأة، معرّفها uid_النوع_المرجع فلا تُحسب المكافأة مرتين
    function ptsDoc(id) { return /databases/$(database)/documents/basira_points/$(id); }
    match /basira_points/{pid} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == me()) || approvedParentOf(resource.data.uid);
      allow create: if signedIn() && myRole() == 'student'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'ref', 'label', 'pts', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
        && request.resource.data.label is string && request.resource.data.label.size() <= 80
        && pid == me() + '_' + request.resource.data.kind + '_' + request.resource.data.ref
        && request.resource.data.pts == {'novel': 30, 'novelq': 10, 'book': 20, 'game': 10, 'test': 10, 'testx': 10, 'act': 2, 'quiz': 15}.get(request.resource.data.kind, -1);
      allow update: if false;
      allow delete: if isTeacher();
    }

    // مجموع نقاط كل طالبة (تقرؤه لوحة المتصدرات): لا يزيد إلا بقيمة مكافأة جديدة أُنشئت في العملية نفسها
    match /basira_scores/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'last', 'updatedAt'])
        && request.resource.data.name == get(/databases/$(database)/documents/basira_users/$(uid)).data.name
        && request.resource.data.last is string
        && !exists(ptsDoc(request.resource.data.last))
        && getAfter(ptsDoc(request.resource.data.last)).data.uid == uid
        && request.resource.data.total == getAfter(ptsDoc(request.resource.data.last)).data.pts;
      allow update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'last', 'updatedAt'])
        && request.resource.data.name == get(/databases/$(database)/documents/basira_users/$(uid)).data.name
        && request.resource.data.last is string
        && !exists(ptsDoc(request.resource.data.last))
        && getAfter(ptsDoc(request.resource.data.last)).data.uid == uid
        && request.resource.data.total == resource.data.total + getAfter(ptsDoc(request.resource.data.last)).data.pts;
      allow delete: if isTeacher();
    }

    // تقييم المعلمة لكل طالبة (معرّفه مفتاح الطالبة في قائمة الصف): تراه الطالبة نفسها ووليّ أمرها الموافَق عليه
    function selfKey(k) { return signedIn() && get(/databases/$(database)/documents/basira_users/$(me())).data.key == k; }
    function parentOfKey(k) { return signedIn() && exists(/databases/$(database)/documents/basira_links/$(me() + '_' + k))
        && get(/databases/$(database)/documents/basira_links/$(me() + '_' + k)).data.status == 'approved'; }
    match /basira_evals/{k} {
      allow read: if isTeacher() || selfKey(k) || parentOfKey(k);
      allow write: if isTeacher();
    }

    // اختبارات المعلمة وإعلاناتها: يقرؤها من سجّل الدخول، وتكتبها المعلمة
    match /basira_quizzes/{id} { allow read: if signedIn(); allow write: if isTeacher(); }
    // الإعلانات: ما كان «للجميع» يراه كل زائر في الصفحة الرئيسية، وإعلان الصف يراه من سجّل الدخول
    match /basira_ann/{id}     { allow read: if resource.data.cls == '' || signedIn(); allow write: if isTeacher(); }

    // إجابات الطالبات في اختبارات المعلمة: محاولة واحدة لكل اختبار (المعرّف = الاختبار_الطالبة)
    match /basira_qres/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == me()) || approvedParentOf(resource.data.uid);
      allow create: if signedIn() && myRole() == 'student' && request.resource.data.uid == me()
        && id == request.resource.data.qid + '_' + me()
        && exists(/databases/$(database)/documents/basira_quizzes/$(request.resource.data.qid));
      // المعلمة تصحّح أسئلة الكتابة فتعدّل الدرجات فقط
      allow update: if isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'fb', 'score', 'pending', 'aiGraded', 'gradedAt']);
      allow delete: if isTeacher();
    }

    // استبيان البصيرة: إجابة واحدة لكل حساب (المعرّف = uid)، تقرؤها المعلمة وصاحب الإجابة
    match /basira_survey/{uid} {
      allow read: if isTeacher() || (signedIn() && me() == uid);
      allow create: if signedIn() && me() == uid && request.resource.data.role == myRole()
        && request.resource.data.role in ['student', 'parent']
        && request.resource.data.keys().hasOnly(['role', 'cls', 'a', 'text', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600;
      allow update: if false;
      allow delete: if isTeacher();
    }

    // محتوى عام يقرؤه الجميع وتكتبه المعلمة
    // تحضير منصة نور: خاص بالمعلمة
    match /basira_preps/{id} { allow read, write: if isTeacher(); }

    match /basira_posts/{id} { allow read: if true; allow write: if isTeacher(); }
    match /basira_books/{id} { allow read: if true; allow write: if isTeacher(); }
    match /basira_site/{id}  { allow read: if true; allow write: if isTeacher(); }
  }
}
