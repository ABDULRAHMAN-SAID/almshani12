{
  "name": "manassah",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "منصّة تعليمية عربية متكاملة: حصص مباشرة مدفوعة، دورات مسجّلة، وملخصات كتب.",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/db/seed.js",
    "reset": "node server/db/seed.js --reset",
    "test": "node --test tests/*.test.js",
    "build:css": "tailwindcss -i src/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/app.css -o public/css/app.css --watch",
    "prestart": "npm run build:css"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
