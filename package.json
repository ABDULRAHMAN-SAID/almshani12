{
  "name": "manassah",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "api": "npm run dev -w apps/api",
    "mobile": "npm run start -w apps/mobile",
    "web": "npm run web -w apps/mobile",
    "admin": "npm run dev -w apps/admin",
    "seed": "npm run seed -w apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "admin:build": "npm run build -w apps/admin",
    "web:export": "npm run export:web -w apps/mobile",
    "web:single": "node apps/mobile/scripts/single-file.mjs",
    "test:api": "npm test -w apps/api"
  }
}
