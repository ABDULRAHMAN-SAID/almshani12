# ================= الأساسيات =================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000

PLATFORM_NAME=منصّة
PLATFORM_TAGLINE=تعلّم بلا حدود — حصص مباشرة، دورات، وملخّصات كتب
SUPPORT_EMAIL=support@example.com

# ================= الأمان =================
# اتركه فارغاً ليُولَّد مفتاح ثابت تلقائياً في data/.jwt_secret
JWT_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10
# فعّله خلف عاكس (nginx / Cloudflare) ليُقرأ عنوان الزائر الحقيقي
TRUST_PROXY=false
# نطاقات مسموحة، افصل بينها بفاصلة. اتركه فارغاً للسماح للجميع (تطوير فقط)
CORS_ORIGINS=

# حدود الطلبات
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=20

# ================= المال =================
CURRENCY=OMR
CURRENCY_SYMBOL=ر.ع
CURRENCY_DECIMALS=3
# 0.05 = ضريبة ٥٪
TAX_RATE=0
# 0.2 = عمولة المنصّة ٢٠٪ (المعلّم يأخذ ٨٠٪)
COMMISSION_RATE=0.2
MIN_PAYOUT=10
REFERRAL_BONUS=1

# ================= الدفع =================
# mock  : بوابة محاكاة للتجربة (لا أموال حقيقية)
# wallet: خصم من رصيد المحفظة
# manual: تحويل بنكي يعتمده المدير
# stripe: بوابة حقيقية (تتطلّب المفاتيح أدناه)
PAYMENT_PROVIDERS=mock,wallet,manual

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

BANK_NAME=بنك مسقط
BANK_ACCOUNT_NAME=منصّة للتعليم
BANK_IBAN=OM00 0000 0000 0000 0000 0000

# ================= البريد =================
# log = يطبع في الطرفية | smtp = إرسال حقيقي (يتطلّب: npm i nodemailer)
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ================= الملفات =================
UPLOAD_MAX_MB=50

# كلمة مرور الحسابات التجريبية عند التعبئة
SEED_PASSWORD=Passw0rd!
