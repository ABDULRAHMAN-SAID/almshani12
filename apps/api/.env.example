# ---- عام ----
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000          # يُستخدم في روابط الملفات الموقّعة وصفحات الدفع
CORS_ORIGINS=                             # فارغ = الكل (تطوير). في الإنتاج: https://app.example.om,https://admin.example.om
TRUST_PROXY=false

# ---- التخزين ----
DATA_DIR=./data                           # قاعدة البيانات والأسرار
STORAGE_DIR=./data/storage                # الملفات الخاصة (كتب/فيديو/مستندات) — لا تُخدَم مباشرة أبداً
DB_FILE=./data/manassah.db
UPLOAD_MAX_MB=200

# ---- الأمان ----
JWT_SECRET=                               # فارغ = يُولَّد ويُحفَظ في DATA_DIR/.jwt_secret
SIGNING_SECRET=                           # توقيع روابط الملفات
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=60
FILE_URL_TTL=900
RATE_LIMIT_ENABLED=true

# ---- رموز التحقّق (OTP) ----
OTP_TTL=300                               # صلاحية الرمز بالثواني
OTP_FIXED_CODE=                           # فارغ = 000000 خارج الإنتاج (تطوير/اختبار)؛ none = يعطّل الرمز الثابت في أي بيئة
# بلا أي مزوّد أدناه يعمل الوضع التجريبي: الرمز 000000 ويُعاد في الاستجابة. مع مزوّد حقيقي تصل رموز حقيقية للأرقام/البريد الحقيقية،
# وتبقى حسابات العرض (+96890000*, +96891000*) وأهداف OTP_TEST_TARGETS على الرمز الثابت.
ALLOW_DEMO_SEED=1                         # 1 = بيانات عرض عند أول تشغيل؛ حسابات العرض (+96890000*, +96891000*) تبقى على الرمز الثابت
ADMIN_PHONE=                              # مع ALLOW_DEMO_SEED=0: رقم هاتفك ليصبح مدير المنصّة الأوّل
RATE_LIMIT_OTP=8                          # طلبات رموز التحقّق لكل IP+هدف كل ١٥ دقيقة
RATE_LIMIT_API=300                        # طلبات API لكل IP في الدقيقة

# --- البريد (SMTP أو Resend) — يُكتشف تلقائياً، أو ثبّته بـ EMAIL_PROVIDER ---
EMAIL_PROVIDER=                           # auto (افتراضي) | smtp | resend | log
EMAIL_FROM=                               # عنوان المرسل الظاهر (افتراضياً SMTP_USER)؛ مثال: "منصّة <no-reply@example.om>"
SMTP_HOST=                                # مثال Gmail: smtp.gmail.com (يحتاج كلمة مرور تطبيق — راجع README)
SMTP_PORT=587                             # 587 (STARTTLS) أو 465 (SSL)
SMTP_SECURE=                              # فارغ = تلقائي (true عند المنفذ 465)
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=                           # بديل SMTP: مفتاح Resend (re_...)

# --- الرسائل النصية / واتساب — يُكتشف تلقائياً، أو ثبّته بـ SMS_PROVIDER ---
SMS_PROVIDER=                             # auto (افتراضي) | twilio_verify | twilio | http | log
# Twilio Verify (الأنسب لعُمان — SMS + واتساب من مرسل Twilio المشترك بلا رقم خاص):
TWILIO_ACCOUNT_SID=                       # ACxxxxxxxx من لوحة Twilio
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=                # VAxxxxxxxx من Verify → Services
# Twilio Messages (رقم/خدمة رسائل خاصة بك بدل Verify):
TWILIO_FROM=                              # رقم Twilio المرسل بصيغة E.164، مثال: +1415XXXXXXX
TWILIO_MESSAGING_SERVICE_SID=             # أو MGxxxxxxxx بدل TWILIO_FROM
TWILIO_WHATSAPP_FROM=                     # رقم واتساب معتمد في Twilio لتفعيل واتساب مع twilio، مثال: +1415XXXXXXX
OTP_WHATSAPP=1                            # 0 = إخفاء خيار واتساب حتى لو كان متاحاً
# بوابة HTTP محلية (Unifonic / Omantel / Ooredoo …): العناصر {to} {to_digits} {text} {code} تُستبدل في الرابط والجسم
SMS_HTTP_URL=                             # مثال: https://el.cloud.unifonic.com/rest/SMS/messages
SMS_HTTP_METHOD=POST                      # GET | POST
SMS_HTTP_HEADERS=                         # JSON، مثال: {"Authorization":"Bearer XXX"}
SMS_HTTP_BODY=                            # قالب الجسم (JSON أو form)، مثال: {"AppSid":"XXX","SenderID":"MANASSAH","Recipient":"{to_digits}","Body":"{text}"}
SMS_HTTP_OK=                              # نص يجب أن يظهر في الاستجابة لاعتبار الإرسال ناجحاً (اختياري)، مثال: SMS_HTTP_OK='"success":true' (بين اقتباسين مفردين)

# --- الحماية (تسري على الإرسال الحقيقي فقط) ---
SMS_ALLOWED_COUNTRIES=+968                # الدول المسموح الإرسال إليها (بفواصل)؛ * = الكل
OTP_SEND_PER_TARGET_HOUR=5                # أقصى رموز لنفس الرقم/البريد في الساعة
OTP_SEND_PER_DAY=300                      # سقف يومي عام للإرسال الحقيقي (حماية الرصيد من SMS pumping)
OTP_RESEND_COOLDOWN=30                    # ثوانٍ بين طلبين لنفس الهدف
OTP_TEST_TARGETS=                         # أهداف تقبل الرمز الثابت دائماً (بفواصل، * في النهاية كبادئة)، مثال: +96899000000,qa@example.om

# ---- الدفع (لا تُخزَّن بيانات بطاقات هنا أبداً) ----
PAYMENT_PROVIDERS=mock,wallet,manual      # في الإنتاج: thawani,wallet,manual
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_NAME=بنك مسقط
BANK_ACCOUNT_NAME=
BANK_IBAN=
TAX_RATE=0

# ---- الغرف المباشرة ----
ROOM_PROVIDER=internal                    # internal (دردشة/حضور/إشارات WebRTC) | livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ROOM_TOKEN_TTL=10800
# خوادم الفيديو المباشر (WebRTC): STUN عام تلقائياً؛ للإنتاج أضف TURN خاصاً (coturn أو Twilio/Metered)
TURN_URL=                                 # مثال: turn:turn.example.om:3478,turns:turn.example.om:5349
TURN_USERNAME=
TURN_CREDENTIAL=
# أو المصفوفة كاملة: ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
