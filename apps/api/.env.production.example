# انسخه إلى .env على الخادم (أو اضبط القيم في لوحة الاستضافة)
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://manassah.example.om     # عنوانك العام — Render وFly يُكتشفان تلقائياً إن تركته فارغاً
CORS_ORIGINS=                               # فارغ = الكل. للإنتاج: https://app.example.om,https://admin.example.om
TRUST_PROXY=true
DATA_DIR=/data                              # قاعدة البيانات والملفات — اربطه بقرص دائم

# الإقلاع الأول (خادم فارغ)
ALLOW_DEMO_SEED=1                           # 1 = بيانات عرض كاملة (طالب 90000010 / معلّم 91000001)؛ 0 = المنهج فقط
ADMIN_PHONE=                                # مع ALLOW_DEMO_SEED=0: رقم هاتفك ليصبح مدير المنصّة الأوّل

# رموز التحقّق (OTP) — بلا مزوّد: الرمز الثابت أدناه فقط. مع مزوّد: رموز حقيقية للأرقام/البريد الحقيقية، وحسابات العرض تبقى على 000000
OTP_FIXED_CODE=000000                       # رمز دخول ثابت حتى ربط مزوّد — اجعله none بعد الربط (يمنع الرمز الثابت لغير حسابات العرض)
OTP_TTL=300                                 # صلاحية الرمز بالثواني
# --- البريد (SMTP أو Resend) — يُكتشف تلقائياً، أو ثبّته بـ EMAIL_PROVIDER=smtp|resend ---
EMAIL_PROVIDER=
EMAIL_FROM=                                 # مثال: "منصّة <no-reply@example.om>" (افتراضياً SMTP_USER)
SMTP_HOST=                                  # Gmail: smtp.gmail.com مع كلمة مرور تطبيق — راجع README
SMTP_PORT=587                               # 587 (STARTTLS) أو 465 (SSL)
SMTP_SECURE=                                # فارغ = تلقائي (true عند 465)
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=                             # بديل SMTP
# --- الرسائل النصية / واتساب — يُكتشف تلقائياً، أو ثبّته بـ SMS_PROVIDER=twilio_verify|twilio|http ---
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=                         # Twilio Verify (SMS + واتساب بلا رقم خاص): ACxxxx
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=                  # VAxxxx من Verify → Services
TWILIO_FROM=                                # Twilio Messages بدل Verify: رقمك المرسل +1415XXXXXXX
TWILIO_MESSAGING_SERVICE_SID=               # أو MGxxxx
TWILIO_WHATSAPP_FROM=                       # رقم واتساب معتمد في Twilio (مع twilio فقط)
OTP_WHATSAPP=1                              # 0 = إخفاء خيار واتساب
SMS_HTTP_URL=                               # بوابة HTTP محلية (Unifonic/Omantel/Ooredoo): {to} {to_digits} {text} {code}
SMS_HTTP_METHOD=POST                        # GET | POST
SMS_HTTP_HEADERS=                           # JSON: {"Authorization":"Bearer XXX"}
SMS_HTTP_BODY=                              # قالب الجسم: {"Recipient":"{to_digits}","Body":"{text}"}
SMS_HTTP_OK=                                # نص متوقّع في الاستجابة عند النجاح (اختياري)، مثال: SMS_HTTP_OK='"success":true' (بين اقتباسين مفردين)
# --- الحماية (الإرسال الحقيقي فقط) ---
# OTP_FIXED_CODE=none                       # في الإنتاج بعد ربط مزوّد: لا رمز ثابت إلا لحسابات العرض وOTP_TEST_TARGETS
SMS_ALLOWED_COUNTRIES=+968                  # الدول المسموحة بفواصل؛ * = الكل
OTP_SEND_PER_TARGET_HOUR=5                  # أقصى رموز لنفس الهدف في الساعة
OTP_SEND_PER_DAY=300                        # سقف يومي عام (حماية الرصيد)
OTP_RESEND_COOLDOWN=30                      # ثوانٍ بين طلبين لنفس الهدف
OTP_TEST_TARGETS=                           # أهداف تقبل الرمز الثابت دائماً: +96899000000,qa@example.om

# الدفع (لا تُخزَّن بيانات بطاقات هنا أبداً)
PAYMENT_PROVIDERS=mock,wallet,manual        # للإنتاج الحقيقي: thawani,wallet,manual
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=

# الغرف المباشرة
ROOM_PROVIDER=internal                      # internal (دردشة/حضور/WebRTC) | livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
